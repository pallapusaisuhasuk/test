  <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#BritishMuseum">
    <rdf:type rdf:resource="https://example.org/tourismkg/2026#Museum"/>
    <rdf:type rdf:resource="https://example.org/tourismkg/2026#CulturalAttraction"/>
    <rdf:type rdf:resource="https://example.org/tourismkg/2026#TouristAttraction"/>
    <tourismkg:hasAccessibilityFeature>
      <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#BritishMuseumStepFreeAccess">
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#StepFreeAccess"/>
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#AccessibilityFeature"/>
        <tourismkg:hasEvidenceRecord rdf:resource="https://example.org/tourismkg/2026#BritishMuseumAccessEvidence"/>
        <tourismkg:accessibilityDetails>Lifts and level-access lifts are shown on the museum map. Gallery closures may affect step-free access.</tourismkg:accessibilityDetails>
      </owl:NamedIndividual>
    </tourismkg:hasAccessibilityFeature>
    <tourismkg:hasAdmissionTicket>
      <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#BritishMuseumGeneralAdmission">
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#AdmissionTicket"/>
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#VisitorInformation"/>
        <tourismkg:hasEvidenceRecord rdf:resource="https://example.org/tourismkg/2026#BritishMuseumAdmissionEvidence"/>
        <tourismkg:isFreeAdmission rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</tourismkg:isFreeAdmission>
      </owl:NamedIndividual>
    </tourismkg:hasAdmissionTicket>
    <tourismkg:locatedInCity>
      <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#London">
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#City"/>
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#GeographicalEntity"/>
        <tourismkg:cityInCountry rdf:resource="https://example.org/tourismkg/2026#England"/>
        <tourismkg:displayName>London</tourismkg:displayName>
      </owl:NamedIndividual>
    </tourismkg:locatedInCity>
    <tourismkg:displayName>British Museum</tourismkg:displayName>
  </owl:NamedIndividual>
