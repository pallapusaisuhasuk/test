  <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#CambridgeToKingsCrossRail">
    <rdf:type rdf:resource="https://example.org/tourismkg/2026#RailService"/>
    <rdf:type rdf:resource="https://example.org/tourismkg/2026#TransportService"/>
    <tourismkg:hasEvidenceRecord>
      <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#KingsCrossRailEvidence">
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#EvidenceRecord"/>
        <tourismkg:evidenceClaimText>Great Northern operates direct trains between Cambridge and London King's Cross.</tourismkg:evidenceClaimText>
        <tourismkg:sourcePublisher>Great Northern</tourismkg:sourcePublisher>
        <tourismkg:sourceTitle>Trains from Cambridge to London Kings Cross</tourismkg:sourceTitle>
        <tourismkg:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.greatnorthernrail.com/journey/cambridge-to-london-kings-cross</tourismkg:sourceURL>
      </owl:NamedIndividual>
    </tourismkg:hasEvidenceRecord>
    <tourismkg:hasEvidenceRecord>
      <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#NationalRailSustainabilityEvidence">
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#EvidenceRecord"/>
        <tourismkg:evidenceClaimText>Direct trains connect Cambridge with London King's Cross and London Liverpool Street. Rail travel can help lower carbon emissions.</tourismkg:evidenceClaimText>
        <tourismkg:sourcePublisher>National Rail</tourismkg:sourcePublisher>
        <tourismkg:sourceTitle>Visit Cambridge by Train</tourismkg:sourceTitle>
        <tourismkg:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nationalrail.co.uk/discover-by-train/great-british-destinations/visit-cambridge-by-train/</tourismkg:sourceURL>
      </owl:NamedIndividual>
    </tourismkg:hasEvidenceRecord>
    <tourismkg:serviceArrivesAt>
      <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#LondonKingsCrossStation">
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#RailwayStation"/>
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#TransportInfrastructure"/>
        <tourismkg:stationServesCity rdf:resource="https://example.org/tourismkg/2026#London"/>
        <tourismkg:displayName>London King's Cross Station</tourismkg:displayName>
      </owl:NamedIndividual>
    </tourismkg:serviceArrivesAt>
    <tourismkg:serviceDepartsFrom>
      <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#CambridgeStation">
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#RailwayStation"/>
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#TransportInfrastructure"/>
        <tourismkg:stationServesCity rdf:resource="https://example.org/tourismkg/2026#Cambridge"/>
        <tourismkg:displayName>Cambridge Railway Station</tourismkg:displayName>
      </owl:NamedIndividual>
    </tourismkg:serviceDepartsFrom>
    <tourismkg:serviceDestinationCity rdf:resource="https://example.org/tourismkg/2026#London"/>
    <tourismkg:serviceOperatedBy>
      <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#GreatNorthern">
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#TransportOperator"/>
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#Organisation"/>
        <tourismkg:displayName>Great Northern</tourismkg:displayName>
      </owl:NamedIndividual>
    </tourismkg:serviceOperatedBy>
    <tourismkg:serviceOriginCity rdf:resource="https://example.org/tourismkg/2026#Cambridge"/>
    <tourismkg:displayName>Cambridge to London King's Cross</tourismkg:displayName>
    <tourismkg:isDirectService rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</tourismkg:isDirectService>
  </owl:NamedIndividual>
