        <tourismkg:hasEvidenceRecord rdf:resource="https://example.org/tourismkg/2026#FitzwilliamAccessEvidence"/>
        <tourismkg:accessibilityDetails>The courtyard entrance provides step-free access. A lift serves the first floor.</tourismkg:accessibilityDetails>
      </owl:NamedIndividual>
    </tourismkg:hasAccessibilityFeature>
    <tourismkg:hasAdmissionTicket>
      <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#FitzwilliamMuseumGeneralAdmission">
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#AdmissionTicket"/>
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#VisitorInformation"/>
        <tourismkg:hasEvidenceRecord rdf:resource="https://example.org/tourismkg/2026#FitzwilliamAdmissionEvidence"/>
        <tourismkg:isFreeAdmission rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</tourismkg:isFreeAdmission>
      </owl:NamedIndividual>
    </tourismkg:hasAdmissionTicket>
    <tourismkg:locatedInCity>
      <owl:NamedIndividual rdf:about="https://example.org/tourismkg/2026#Cambridge">
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#City"/>
        <rdf:type rdf:resource="https://example.org/tourismkg/2026#GeographicalEntity"/>
        <tourismkg:cityInCountry rdf:resource="https://example.org/tourismkg/2026#England"/>
        <tourismkg:displayName>Cambridge</tourismkg:displayName>
      </owl:NamedIndividual>
    </tourismkg:locatedInCity>
    <tourismkg:displayName>Fitzwilliam Museum</tourismkg:displayName>
